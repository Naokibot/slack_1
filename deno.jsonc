{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "fmt": {
    "include": [
      "datastores",
      "functions",
      "lib",
      "manifest.ts",
      "triggers",
      "workflows.ts",
      "tests"
    ]
  },
  "lint": {
    "include": [
      "datastores",
      "functions",
      "lib",
      "manifest.ts",
      "triggers",
      "workflows.ts",
      "tests"
    ]
  },
  "lock": false,
  "tasks": {
    "check": "deno fmt && deno lint && deno check manifest.ts && deno test"
  },
  "imports": {
    "deno-slack-sdk/": "https://deno.land/x/deno_slack_sdk@2.15.1/",
    "deno-slack-api/": "https://deno.land/x/deno_slack_api@2.8.0/"
  }
}
