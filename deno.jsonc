{
  "imports": {
    "deno-slack-sdk/": "https://deno.land/x/deno_slack_sdk@2.15.0/",
    "deno-slack-api/": "https://deno.land/x/deno_slack_api@2.8.0/",
    "@std/assert": "jsr:@std/assert@^1.0.15"
  },
  "fmt": {
    "lineWidth": 100,
    "include": ["manifest.ts", "workflows.ts", "datastores", "functions", "lib", "triggers", "tests"]
  },
  "lint": {
    "include": ["manifest.ts", "workflows.ts", "datastores", "functions", "lib", "triggers", "tests"]
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check manifest.ts && deno test"
  }
}
