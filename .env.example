# Slack Socket Mode
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Channels used for automatic posts. Commands can still be used elsewhere.
COUNTDOWN_CHANNEL_ID=C0123456789
REMINDER_CHANNEL_ID=C0123456789

# Optional comma-separated user IDs allowed to change global settings.
# Empty means any workspace user may run /kosen set-date and set-time.
ADMIN_USER_IDS=

DATABASE_PATH=data/bot.sqlite3
KOSEN_EXAM_DATE=2027-02-14
KOSEN_NOTIFY_TIME=07:00
REMINDER_POLL_SECONDS=15
HEALTH_PORT=8080
LOG_LEVEL=INFO
